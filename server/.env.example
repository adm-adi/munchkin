# Munchkin Tracker Server Configuration
# Copy to /etc/munchkin/server.env (mode 0600) or server/.env for local development.

# Runtime environment ("production" | "development")
NODE_ENV=production

# TCP port for HTTP/WebSocket listener
PORT=8765

# Required HS256 signing secret (minimum 32 characters; generate with: openssl rand -hex 48)
JWT_SECRET=replace-with-at-least-32-character-random-secret

# SQLite database path (keep outside the code tree in production)
MUNCHKIN_DB_PATH=/var/lib/munchkin/munchkin.db

# Backup destination & optional encryption settings (used by server/scripts/backup_db.sh)
MUNCHKIN_BACKUP_DIR=/var/lib/munchkin/backups
# MUNCHKIN_BACKUP_AGE_RECIPIENT=age1...
# MUNCHKIN_BACKUP_PASSPHRASE=replace-with-strong-backup-passphrase

# Comma-separated list of additional allowed WebSocket origins (e.g. https://munchkin.example.com)
MUNCHKIN_ALLOWED_ORIGINS=

# Set to "1" or "true" when running behind a trusted reverse proxy (Nginx/Caddy/Traefik)
MUNCHKIN_TRUST_PROXY=0

# Optional direct TLS termination (leave unset when terminating TLS at a reverse proxy)
# MUNCHKIN_TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
# MUNCHKIN_TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
